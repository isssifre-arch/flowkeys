{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "流光钢琴",
  "version": "0.3.1",
  "identifier": "com.flowkeys.piano",
  "build": {
    "frontendDist": "../app",
    "devUrl": "http://127.0.0.1:9200",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "流光钢琴",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
